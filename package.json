{
  "name": "g_worldsim",
  "private": true,
  "version": "0.1.0",
  "description": "Autonomous agent world simulator: headless server, My PC viewer client, control panel",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/client",
    "packages/panel"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b packages/protocol packages/server && node tools/build-client.mjs",
    "start": "node --disable-warning=ExperimentalWarning packages/server/dist/main.js",
    "dev": "npm run build && npm start -- --speed 1",
    "test": "npm run build && node tools/test.mjs",
    "bench": "npm run build && node --disable-warning=ExperimentalWarning packages/server/dist/bench.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
