# Copy to .env (never commit .env). Values stay on the server; clients never see them.

# Control panel / admin API (at least 24 characters).
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional fixed viewer tokens (TVs normally pair with a code from the panel instead), one per player: name:token, comma separated (tokens at least 16 characters).
VIEWER_TOKENS=imad:change-me-viewer-token-1,guest:change-me-viewer-token-2

# Firestore backup (optional): path to a service account JSON file, then set cloud.enabled in worldsim.config.json.
# FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json

# Cloudflare named tunnel (tunnel.provider = "cloudflare")
# CLOUDFLARE_TUNNEL_TOKEN=

# AI brain: pick the provider and model in the control panel (AI brain card).
# Gemini: a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Ollama on this PC or the LAN needs no key (address in the panel, default http://127.0.0.1:11434).
# Only for ollama.com's hosted models:
# OLLAMA_API_KEY=
